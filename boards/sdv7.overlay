/*
 * SPDX-License-Identifier: MIT
 * MeshCore -> ZephCore migrator, nRF52840 + SoftDevice s140 v7.x + Adafruit bootloader.
 *
 * Flash map = ZephCore's (zephcore/boards/common/nrf52_partitions_sd7.dtsi), so
 * lfs_partition is the volume ZephCore mounts. MeshCore's own littlefs volume (Adafruit
 * InternalFS, 7 x 4 KB at 0xED000) sits inside the top of it and is read by main.c
 * before this volume is erased.
 *
 *   0x00000 - 0x27000  SoftDevice (reserved)
 *   0x27000 - 0xD0000  application (this image)
 *   0xD0000 - 0xD4000  NVS settings / BLE bonds (storage_partition)
 *   0xD4000 - 0xF4000  LittleFS /lfs (lfs_partition)
 *   0xF4000 - 0x100000 bootloader (reserved)
 */

/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &storage_partition;

/ {
	chosen {
		zephyr,code-partition = &code_partition;
		zephyr,console = &cdc_acm_uart;
		zephyr,shell-uart = &cdc_acm_uart;
	};

	/* Mounted by main.c, never at boot: see prj.conf. */
	fstab {
		compatible = "zephyr,fstab";
		lfs: lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&lfs_partition>;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

&zephyr_udc0 {
	cdc_acm_uart: cdc_acm_uart {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* No QSPI probing on boards that have none. */
&qspi {
	status = "disabled";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "softdevice";
			read-only;
			reg = <0x00000000 0x00027000>;
		};

		code_partition: partition@27000 {
			label = "Application";
			reg = <0x00027000 0x000A9000>;
		};

		storage_partition: partition@d0000 {
			label = "storage";
			reg = <0x000D0000 0x00004000>;
		};

		lfs_partition: partition@d4000 {
			label = "lfs";
			reg = <0x000D4000 0x00020000>;
		};

		uf2_partition: partition@f4000 {
			label = "UF2";
			read-only;
			reg = <0x000F4000 0x0000C000>;
		};
	};
};
